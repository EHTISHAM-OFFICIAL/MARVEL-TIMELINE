rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Fixed bootstrap administrator. This is enforced by Firestore itself,
    // so changing browser JavaScript cannot grant database access.
    function isBootstrapAdmin() {
      return request.auth != null
        && request.auth.uid == "025r87YHM0bE9B7onPItzwp5jct1";
    }

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (
          signedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true
        );
    }

    match /admins/{adminId} {
      allow get: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /siteConfig/public {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /siteConfig/private {
      allow read, write: if isAdmin();
    }
  }
}
