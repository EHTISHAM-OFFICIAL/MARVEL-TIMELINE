rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{adminId} {
      // A signed-in user can verify only their own admin record.
      // An enabled administrator can read/manage administrator records.
      allow get: if signedIn() && (request.auth.uid == adminId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      // Normal users can access only their own tracker data.
      // Administrators can read the user collection for the admin console.
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if signedIn() && request.auth.uid == userId;
    }

    match /siteConfig/public {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /siteConfig/private {
      allow read, write: if isAdmin();
    }
  }
}